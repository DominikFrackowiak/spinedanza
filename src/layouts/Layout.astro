---
import '../styles/global.css'
import { ClientRouter } from 'astro:transitions'
import Header from '../components/organisms/header/index.astro'
import Footer from '../components/organisms/footer/index.astro'
import Button from '../components/atoms/button/index.astro'
import ArrowUpIcon from '../components/atoms/arrow-up-icon/index.astro'
import ogImage from '../assets/images/hero/marta-wrzesinska-jesus-alonso-contact-impro-1.webp'
interface Props {
	title?: string
	description?: string
	is404?: boolean
}
const {
	title = 'SPINE - Danza Contact Improvisación en Madrid',
	description = 'Ciclo de profundización en Danza Contact Improvisación en Madrid: escucha, peso, presencia, relación e investigación del movimiento.',
	is404 = false,
} = Astro.props
const isHomePage = Astro.url.pathname === '/'
const siteUrl = Astro.site ?? Astro.url.origin
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href
const socialImageUrl = new URL(ogImage.src, canonicalUrl).href
---

<!doctype html>
<html lang='es' class={isHomePage ? 'overflow-hidden' : undefined}>
	<head>
		<!-- Google tag (gtag.js) -->
		<script
			is:inline
			async
			src='https://www.googletagmanager.com/gtag/js?id=G-D26NCT8Z2L'
		></script>
		<script is:inline>
			window.dataLayer = window.dataLayer || []
			function gtag() {
				window.dataLayer.push(arguments)
			}
			gtag('js', new Date())
			gtag('config', 'G-D26NCT8Z2L')
		</script>
		<meta charset='UTF-8' />
		<meta name='viewport' content='width=device-width' />
		<link rel='icon' type='image/png' sizes='32x32' href='/favicon-32x32.png' />
		<link rel='icon' type='image/png' sizes='16x16' href='/favicon-16x16.png' />
		<link rel='icon' href='/favicon.ico' sizes='any' />
		<link rel='apple-touch-icon' sizes='180x180' href='/apple-touch-icon.png' />
		<meta name='generator' content={Astro.generator} />
		<meta name='description' content={description} />
		<link rel='canonical' href={canonicalUrl} />
		<meta property='og:type' content='website' />
		<meta property='og:locale' content='es_ES' />
		<meta property='og:title' content={title} />
		<meta property='og:description' content={description} />
		<meta property='og:url' content={canonicalUrl} />
		<meta property='og:image' content={socialImageUrl} />
		<meta name='twitter:card' content='summary_large_image' />
		<meta name='twitter:title' content={title} />
		<meta name='twitter:description' content={description} />
		<meta name='twitter:image' content={socialImageUrl} />
		<title>{title}</title>
		<ClientRouter />
	</head>
	<body class={isHomePage ? 'overflow-hidden' : 'overflow-x-hidden'}>
		{!is404 ? <Header /> : null}
		<main
			class={isHomePage ? 'h-screen overflow-hidden' : 'flex flex-col gap-4'}
		>
			<slot />

			<!-- <a href='#hero' class='h-10! w-10!' -->
			<Button
				as='a'
				href='#hero'
				'
				isRounded
				className='fixed right-0 mr-4 lg:mr-10 bottom-20 z-10 el-none toBeToggled'
			>
				<ArrowUpIcon class='h-10 w-10' /></Button
			>
		</main>

		{!is404 ? <Footer /> : null}
	</body>
</html>

<script>
	let arrowObserver: IntersectionObserver

	const setArrowVisibility = (arrowUp: Element, isVisible: boolean) => {
		arrowUp.classList.toggle('el-none', !isVisible)
		arrowUp.classList.toggle('el-block', isVisible)
	}

	const syncArrowWithHero = () => {
		const arrowUp = document.querySelector('.toBeToggled')
		const hero = document.querySelector('#hero')

		arrowObserver?.disconnect()

		if (!arrowUp) return

		setArrowVisibility(arrowUp, false)

		if (!hero) return

		if (typeof (window as any).IntersectionObserver === 'undefined') {
			const updateArrowVisibility = () => {
				setArrowVisibility(arrowUp, window.scrollY >= hero.clientHeight)
			}

			window.addEventListener('scroll', updateArrowVisibility, {
				passive: true,
			})
			window.addEventListener('resize', updateArrowVisibility)
			updateArrowVisibility()
			return
		}

		arrowObserver = new IntersectionObserver(
			([entry]) => {
				setArrowVisibility(arrowUp, !entry.isIntersecting)
			},
			{ threshold: 0 }
		)

		arrowObserver.observe(hero)
	}

	document.addEventListener('astro:page-load', syncArrowWithHero)
	syncArrowWithHero()
</script>
