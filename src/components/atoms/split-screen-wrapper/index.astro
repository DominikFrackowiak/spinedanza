---
import { cn } from '../../../utils/cn'
interface Props {
	className?: string
	leftSideClassName?: string
	rightSideClassName?: string
	leftWidth?: string
	rightWidth?: string
}
const {
	className,
	leftWidth = 'w-1/2',
	leftSideClassName,
	rightWidth = 'w-1/2',
	rightSideClassName,
} = Astro.props
---

<div class={cn('flex w-full max-w-6xl', className)}>
	<div class={cn(leftWidth, leftSideClassName)}><slot name='left' /></div>
	<div class={cn(rightWidth, rightSideClassName)}><slot name='right' /></div>
</div>
