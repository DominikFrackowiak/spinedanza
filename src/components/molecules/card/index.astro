---
import { cn } from '../../../utils/cn'
interface Props {
	className?: string
	background?: 'bg-accent' | 'bg-white'
}

const { className, background = 'bg-accent' } = Astro.props
---

<div
	class={cn(
		'flex flex-col gap-3 justify-center items-center py-5 px-4 text-center min-h-30 rounded-lg shadow-xl border border-accent',
		background,
		className
	)}
>
	<slot />
</div>
