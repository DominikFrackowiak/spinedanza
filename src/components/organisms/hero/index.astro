---
import Button from '../../atoms/button/index.astro'
import { cn } from '../../../utils/cn'

interface Props {
	backgroundImage?: string
	video?: string
	title: string
	description1: string
	description2: string
	buttonContent: string
}
const {
	backgroundImage,
	video,
	title,
	description1,
	description2,
	buttonContent,
} = Astro.props

const normalizedBackgroundImage = backgroundImage?.trim()
---

<div
	class={cn(
		'relative flex w-screen h-screen overflow-hidden bg-center bg-cover bg-no-repeat'
	)}
	style={normalizedBackgroundImage
		? { backgroundImage: `url("${normalizedBackgroundImage}")` }
		: undefined}
>
	{
		video ? (
			<video
				autoplay
				muted
				loop
				class='absolute top-0 left-0 overflow-hidden scale-400 lg:scale-100'
			>
				<source src={video} type='video/mp4' />
			</video>
		) : null
	}
	<div
		class='h-full w-full flex flex-col items-center justify-center absolute top-0 bottom-0 left-0 right-0 bg-black/40 gap-8'
	>
		<h1 class='hero-fade-in text-accent font-headings font-bold text-9xl'>
			{title}
		</h1>
		<h3 class='flex flex-col gap-2 font-headings text-accent'>
			<span class='hero-fade-in hero-fade-in-delay-1'>{description1}</span>
			<span class='hero-fade-in hero-fade-in-delay-2'>{description2}</span>
		</h3>
		<div class='hero-fade-in hero-fade-in-delay-3'>
			<Button>{buttonContent}</Button>
		</div>
	</div>
</div>

<style>
	.hero-fade-in {
		opacity: 0;
		animation-delay: 0.4s;
		animation: hero-fade-in 0.8s forwards;
	}

	.hero-fade-in-delay-1 {
		animation-delay: 0.8s;
	}

	.hero-fade-in-delay-2 {
		animation-delay: 1.2s;
	}

	.hero-fade-in-delay-3 {
		animation-delay: 1.6s;
	}

	@keyframes hero-fade-in {
		from {
			opacity: 0;
		}

		to {
			opacity: 1;
		}
	}
</style>
