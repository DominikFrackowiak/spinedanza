---
import { cn } from '../../../utils/cn'
const currentPath = Astro.url.pathname
import { socialNavigation } from '../../../constants/navigation'
import FacebookIcon from '../../atoms/facebook-icon/index.astro'
import WhatsAppIcon from '../../atoms/whatsapp-icon/index.astro'
import InstagramIcon from '../../atoms/instagram-icon/index.astro'
import spineLogo from '../../../assets/images/spine-green-small.svg'
import kraftwebLogo from '../../../assets/images/kraftweb-logo-small.svg'
import kraftwebDarkLogo from '../../../assets/images/kraftweb-dark-small.svg'

const socialIconMap = {
	facebook: FacebookIcon,
	instagram: InstagramIcon,
	whatsapp: WhatsAppIcon,
} satisfies Record<
	(typeof socialNavigation)[number]['icon'],
	typeof FacebookIcon
>
---

<footer
	class={cn(
		'flex w-screen items-center justify-between bottom-0 left-0 py-6 px-4 lg:px-10',
		currentPath === '/' ? 'fixed' : 'relative'
	)}
>
	<div
		class='flex flex-col lg:flex-row items-start lg:items-center gap-2 lg:gap-4'
	>
		<img src={spineLogo.src} alt='Spine - logo' />
		<nav class='flex gap-2'>
			{
				socialNavigation.map(el => {
					const Icon = socialIconMap[el.icon]

					return (
						<a
							href={el.url}
							aria-label={el.title}
							target='_blank'
							rel='noreferrer'
							class={cn(
								'h-5 w-5',
								currentPath === '/' ? 'text-white' : 'text-dark-gray'
							)}
						>
							<Icon />
						</a>
					)
				})
			}
		</nav>
	</div>
	<div
		class='flex flex-col lg:flex-row items-end lg:items-center gap-2 lg:gap-4'
	>
		<span
			class={cn(
				'text-sm!',
				currentPath === '/' ? 'text-white' : 'text-dark-gray'
			)}>Designed and developed by:</span
		>
		<a href='https://kraftweb.eu/?locale=es'
			><img
				src={currentPath === '/' ? kraftwebLogo.src : kraftwebDarkLogo.src}
				alt='kraftweb.eu logo'
			/></a
		>
	</div>
</footer>
