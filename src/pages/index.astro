---
import Layout from '../layouts/Layout.astro'
import Hero from '../components/organisms/hero/index.astro'
const video =
	'https://res.cloudinary.com/dluws4pqk/video/upload/f_auto,q_auto/v1793633000/hero-video_egupc5.mp4'
const poster =
	'https://res.cloudinary.com/dluws4pqk/video/upload/f_auto,q_auto/v1793633000/hero-video_egupc5.jpg'

const title = 'SPINE - Danza Contact Improvisación en Madrid'
const description =
	'Ciclo de profundización en Danza Contact Improvisación en Madrid: 8 módulos sobre escucha, peso, presencia, relación e investigación del movimiento.'
---

<Layout title={title} description={description}>
	<div class='h-screen overflow-hidden'>
		<Hero
			title='SPINE'
			description1='CICLO DE PROFUNDIZACIÓN EN'
			description2='DANZA CONTACT IMPROVISACIÓN'
			video={video}
      poster={poster}
			isButtonRounded={false}
			isMain={true}
			href='/propuesta'
		>
			<span slot='button' class='text-lg!'>Ver la propuesta</span>
		</Hero>
	</div>
</Layout>
